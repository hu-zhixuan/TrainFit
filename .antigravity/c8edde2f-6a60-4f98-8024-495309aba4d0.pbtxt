    replacement_chunks {
      replacement_content: "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<vector xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:aapt=\"http://schemas.android.com/aapt\"\n    android:width=\"108dp\"\n    android:height=\"108dp\"\n    android:viewportWidth=\"108\"\n    android:viewportHeight=\"108\">\n    \n    <!-- Barbell and progressive overload plate emblem with energy flame -->\n    <!-- Central Bar -->\n    <path\n        android:fillColor=\"#E2E8F0\"\n        android:pathData=\"M30,51h48v6h-48z\" />\n\n    <!-- Left Plate Inner -->\n    <path\n        android:fillColor=\"#38BDF8\"\n        android:pathData=\"M34,36h6v36h-6z\" />\n    <!-- Left Plate Outer -->\n    <path\n        android:fillColor=\"#0EA5E9\"\n        android:pathData=\"M24,41h7v26h-7z\" />\n\n    <!-- Right Plate Inner -->\n    <path\n        android:fillColor=\"#38BDF8\"\n        android:pathData=\"M68,36h6v36h-6z\" />\n    <!-- Right Plate Outer -->\n    <path\n        android:fillColor=\"#0EA5E9\"\n        android:pathData=\"M77,41h7v26h-7z\" />\n\n    <!-- Center AI Flame / Calorie Pulse Emblem -->\n    <path\n        android:pathData=\"M54,30 C58,37 63,42 63,50 C63,56 59,60 54,60 C49,60 45,56 45,50 C45,43 51,37 54,30 Z\">\n        <aapt:attr name=\"android:fillColor\">\n            <gradient\n                android:angle=\"270\"\n                android:endX=\"54\"\n                android:endY=\"60\"\n                android:startX=\"54\"\n                android:startY=\"30\"\n                android:type=\"linear\">\n                <item android:color=\"#F97316\" android:offset=\"0.0\" />\n                <item android:color=\"#EF4444\" android:offset=\"1.0\" />\n            </gradient>\n        </aapt:attr>\n    </path>\n\n    <!-- Upward Growth / Progressive Overload Arrow Accent -->\n    <path\n        android:strokeColor=\"#10B981\"\n        android:strokeWidth=\"3\"\n        android:strokeLineCap=\"round\"\n        android:strokeLineJoin=\"round\"\n       