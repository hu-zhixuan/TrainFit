        lines {
          text: "            val deficitRatio = if (targetDeficit > 0) (currentDeficit / targetDeficit).coerceIn(0.0, 1.5).toFloat() else 0f"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val isTargetMet = currentDeficit >= targetDeficit"
