  planner_response {
    response: "\350\277\231\346\254\276\345\272\224\347\224\250\344\270\223\344\270\272**\345\201\245\350\272\253\350\256\255\347\273\203\344\270\216\351\245\256\351\243\237\347\203\255\351\207\217\347\274\272\345\217\243\350\277\275\350\270\252**\350\256\276\350\256\241\357\274\214\346\240\270\345\277\203\346\224\257\346\214\201**\350\207\252\347\204\266\350\257\255\350\250\200/\350\257\255\351\237\263\345\277\253\351\200\237\345\217\243\345\226\267\350\256\260\350\264\246**\344\270\216**\350\207\252\345\212\250\350\256\241\347\256\227\347\203\255\351\207\217\347\274\272\345\217\243**\343\200\202\344\273\245\344\270\213\346\230\257\345\205\267\344\275\223\347\232\204\344\275\277\347\224\250\346\226\271\346\263\225\344\270\216\346\223\215\344\275\234\346\265\201\347\250\213\357\274\232\n\n---\n\n### 1. \351\246\226\346\254\241\344\275\277\347\224\250\357\274\232\350\256\276\347\275\256\350\272\253\344\275\223\346\241\243\346\241\210\344\270\216\347\203\255\351\207\217\347\233\256\346\240\207\n1. \347\202\271\345\207\273\351\246\226\351\241\265\345\217\263\344\270\212\350\247\222\347\232\204 **\346\241\243\346\241\210\350\256\276\347\275\256 (\360\237\221\244 \345\233\276\346\240\207)**\343\200\202\n2. \345\241\253\345\206\231\346\202\250\347\232\204**\346\200\247\345\210\253\343\200\201\350\272\253\351\253\230\343\200\201\344\275\223\351\207\215\343\200\201\345\271\264\351\276\204**\357\274\214\347\263\273\347\273\237\345\260\206\350\207\252\345\212\250\344\275\277\347\224\250\347\247\221\345\255\246\345\205\254\345\274\217\350\256\241\347\256\227\346\202\250\347\232\204 **\345\237\272\347\241\200\344\273\243\350\260\242 (BMR)** \345\222\214 **\346\257\217\346\227\245\346\227\245\345\270\270\346\200\273\346\266\210\350\200\227 (TDEE)**\343\200\202\n3. \351\200\211\346\213\251\345\201\245\350\272\253\347\233\256\346\240\207\357\274\210\345\246\202**\345\207\217\350\204\202\345\241\221\345\275\242**\357\274\211\357\274\214\350\256\276\345\256\232\346\202\250\347\232\204**\347\233\256\346\240\207\346\257\217\346\227\245\347\203\255\351\207\217\347\274\272\345\217\243**\357\274\210\345\246\202 450 kcal\357\274\211\345\217\212\344\270\211\345\244\247\350\220\245\345\205\273\347\264\240\347\233\256\346\240\207\357\274\214\347\202\271\345\207\273\344\277\235\345\255\230\343\200\202\n\n---\n\n### 2. \350\257\255\351\237\263\350\256\260\345\275\225\351\245\256\351\243\237\344\270\216\350\207\252\345\212\250\347\256\227\347\203\255\351\207\217\n1. \345\234\250\351\246\226\351\241\265\346\210\226\345\272\225\351\203\250 **\343\200\214\351\245\256\351\243\237\343\200\215** \351\241\265\351\235\242\357\274\214\347\202\271\345\207\273 **\343\200\214\360\237\216\231\357\270\217 \350\257\255\351\237\263\345\217\243\345\226\267\351\245\256\351\243\237\343\200\215** \346\214\211\351\222\256\343\200\202\n2. \345\257\271\347\235\200\346\211\213\346\234\272\350\257\264\350\257\235\357\274\214\344\276\213\345\246\202\357\274\232\n   > *\342\200\234\344\270\255\345\215\210\345\220\203\344\272\206200\345\205\213\347\261\263\351\245\255\343\200\201200\345\205\213\351\246\231\347\205\216\351\270\241\350\203\270\350\202\211\345\222\214150\345\205\213\346\260\264\347\205\256\350\245\277\345\205\260\350\212\261\342\200\235*  \n   > *\342\200\234\346\227\251\351\244\220\345\226\235\344\272\206250\346\257\253\345\215\207\347\272\257\347\211\233\345\245\266\357\274\214\345\220\203\344\272\206\344\270\244\344\270\252\346\260\264\347\205\256\350\233\213\345\222\214\344\270\200\347\211\207\345\205\250\351\272\246\351\235\242\345\214\205\342\200\235*  \n   > *\342\200\234\345\212\240\351\244\220\345\226\235\344\272\206\344\270\200\345\213\272\344\271\263\346\270\205\350\233\213\347\231\275\347\262\211\345\222\214\344\270\200\346\240\271\351\246\231\350\225\211\342\200\235*\n3. \347\263\273\347\273\237\344\274\232\350\207\252\345\212\250\345\256\214\346\210\220\344\273\245\344\270\213\345\210\206\346\236\220\357\274\232\n   - **\346\213\206\350\247\243\351\243\23