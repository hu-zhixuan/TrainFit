      replacement_content: "    suspend fun parseDietVoice(voiceText: String): ParsedDietResult = withContext(Dispatchers.IO) {\n        val apiKey = BuildConfig.GEMINI_API_KEY\n        if (apiKey.isBlank() || apiKey == \"MY_GEMINI_API_KEY\") {\n            Log.w(\"GeminiFitnessService\", \"No valid API key found, using intelligent local heuristic diet parser\")\n            return@withContext fallbackParseDiet(voiceText)\n        }\n\n        val systemPrompt = \"\"\"\n            \344\275\240\346\230\257\344\270\200\344\270\252\344\270\223\344\270\232\350\277\220\345\212\250\350\220\245\345\205\273\345\270\210\343\200\202\350\257\267\345\210\206\346\236\220\347\224\250\346\210\267\347\224\250\350\257\255\351\237\263\345\217\243\345\226\267\350\256\260\345\275\225\347\232\204\351\245\256\351\243\237\345\206\205\345\256\271\343\200\202\n            \346\240\270\345\277\203\344\273\273\345\212\241\357\274\232\n            1. \350\257\206\345\210\253\345\271\266\346\217\220\345\217\226\346\211\200\346\234\211\346\217\220\345\210\260\347\232\204\351\243\237\347\211\251\351\241\271\345\217\212\345\205\266\345\244\247\346\246\202\345\205\213\346\225\260/\345\210\206\351\207\217 (estimatedGrams)\343\200\202\350\213\245\347\224\250\346\210\267\350\257\264\"\344\270\200\347\242\227\347\261\263\351\245\255\"\346\214\211150g\350\256\241\357\274\214\"\344\270\244\344\270\252\351\270\241\350\233\213\"\346\214\211100g\350\256\241\357\274\214\"\344\270\200\345\213\272\350\233\213\347\231\275\347\262\211\"\346\214\21130g\350\256\241\357\274\214\"\344\270\200\347\223\266\347\211\233\345\245\266\"\346\214\211250g\350\256\241\343\200\202\n            2. \346\240\271\346\215\256\351\243\237\347\211\251\347\232\204\347\234\237\345\256\236\350\220\245\345\205\273\346\210\220\345\210\206\357\274\214\347\262\276\347\241\256\350\256\241\347\256\227\346\257\217\351\241\271\351\243\237\347\211\251\347\232\204\347\203\255\351\207\217(calories, kcal)\343\200\201\350\233\213\347\231\275\350\264\250(proteinG, g)\343\200\201\347\242\263\346\260\264\345\214\226\345\220\210\347\211\251(carbsG, g)\343\200\201\350\204\202\350\202\252(fatG, g)\343\200\202\n            3. \350\256\241\347\256\227\346\225\264\351\244\220\347\232\204\346\200\273\347\203\255\351\207\217(totalCalories)\343\200\201\344\270\211\345\244\247\350\220\245\345\205\273\347\264\240\346\200\273\345\222\214\357\274\214\345\271\266\345\210\244\346\226\255\351\244\220\346\254\241\347\261\273\345\236\213(mealType: \"\346\227\251\351\244\220\"/\"\345\215\210\351\244\220\"/\"\346\231\232\351\244\220\"/\"\345\212\240\351\244\220/\350\241\245\345\211\202\")\343\200\202\n            4. \347\224\237\346\210\220\347\256\200\347\237\255\347\232\204\351\243\237\347\211\251\346\221\230\350\246\201(foodSummary)\345\222\214\344\270\200\345\217\245\350\257\235\350\220\245\345\205\273\347\202\271\350\257\204(advice)\343\200\202\n            \n            \345\277\205\351\241\273\344\270\245\346\240\274\350\276\223\345\207\272\344\273\245\344\270\213\346\240\274\345\274\217\347\232\204\347\272\257JSON\345\257\271\350\261\241\357\274\214\344\270\215\350\246\201\345\214\205\345\220\253\344\273\273\344\275\225Markdown\346\240\207\347\255\276\346\210\226\351\242\235\345\244\226\346\226\207\345\255\227\357\274\232\n            {\n              \"mealType\": \"\345\215\210\351\244\220\",\n              \"foodSummary\": \"\347\261\263\351\245\255200g + \351\246\231\347\205\216\351\270\241\350\203\270\350\202\211200g + \346\260\264\347\205\256\350\245\277\345\205\260\350\212\261150g\",\n              \"totalCalories\": 548.0,\n              \"proteinG\": 55.2,\n              \"carbsG\": 57.0,\n              \"fatG\": 8.4,\n              \"items\": [\n                { \"name\": \"\347\261\263\351\245\255\", \"estimatedGrams\": 200.0, \"calories\": 232.0, \"proteinG\": 5.0, \"carbsG\": 51.0, \"fatG\": 0.6 },\n                { \"name\": \"\351\246\231\347\205\216\351\270\241\350\203\270\350\202\211\", \"estimatedGrams\":