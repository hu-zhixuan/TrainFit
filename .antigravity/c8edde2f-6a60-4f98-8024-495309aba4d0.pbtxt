pile(\"(?:\" + Pattern.quote(matchedKeyword) + \"\\\\s*(\\\\d+)|(\\\\d+)\\\\s*(?:\345\205\213|g|\345\215\203\345\205\213|kg|ml|\346\257\253\345\215\207)?\\\\s*\" + Pattern.quote(matchedKeyword) + \"|(\\\\d+)\\\\s*(?:\345\205\213|g|ml|\346\257\253\345\215\207))\")\n                val matcher = gramPattern.matcher(text)\n                if (matcher.find()) {\n                    val g1 = matcher.group(1)?.toDoubleOrNull()\n                    val g2 = matcher.group(2)?.toDoubleOrNull()\n                    val g3 = matcher.group(3)?.toDoubleOrNull()\n                    val detected = g1 ?: g2 ?: g3\n                    if (detected != null && detected in 5.0..2000.0) {\n                        grams = detected\n                    }\n                } else if (text.contains(\"\344\270\244\344\270\252\") || text.contains(\"2\344\270\252\") || text.contains(\"2\345\217\252\")) {\n                    if (profile.displayName.contains(\"\351\270\241\350\233\213\")) grams = 100.0\n                } else if (text.contains(\"\344\270\211\344\270\252\") || text.contains(\"3\344\270\252\")) {\n                    if (profile.displayName.contains(\"\351\270\241\350\233\213\")) grams = 150.0\n                } else if (text.contains(\"\344\270\200\345\213\272\") || text.contains(\"1\345\213\272\")) {\n                    if (profile.displayName.contains(\"\350\233\213\347\231\275\347\262\211\")) grams = 30.0\n                } else if (text.contains(\"\344\270\244\345\213\272\") || text.contains(\"2\345\213\272\")) {\n                    if (profile.displayName.contains(\"\350\233\213\347\231\275\347\262\211\")) grams = 60.0\n                } else if (text.contains(\"\344\270\200\345\260\217\347\242\227\") || text.contains(\"1\347\242\227\")) {\n                    if (profile.displayName.contains(\"\347\261\263\351\245\255\")) grams = 150.0\n                } else if (text.contains(\"\344\270\200\345\244\247\347\242\227\")) {\n                    if (profile.displayName.contains(\"\347\261\263\351\245\255\")) grams = 250.0\n                }\n\n                val itemCalories = Math.round((profile.kcalPer100g * (grams / 100.0)) * 10.0) / 10.0\n                val itemProtein = Math.round((profile.pPer100g * (grams / 100.0)) * 10.0) / 10.0\n                val itemCarbs = Math.round((profile.cPer100g * (grams / 100.0)) * 10.0) / 10.0\n                val itemFat = Math.round((profile.fPer100g * (grams / 100.0)) * 10.0) / 10.0\n\n                extractedItems.add(\n                    FoodItemDetail(\n                        name = profile.displayName,\n                        estimatedGrams = grams,\n                        calories = itemCalories,\n                        proteinG = itemProtein,\n                        carbsG = itemCarbs,\n                        fatG = itemFat\n                    )\n                )\n                matchedSummaries.add(\"${profile.displayName}${grams.toInt()}g\")\n            }\n        }\n\n        // Fallback if no specific food recognized\n        if (extractedItems.isEmpty()) {\n            val defaultCal = 480.0\n            val defaultP = 30.0\n            val defaultC = 55.0\n            val defaultF = 12.0\n            val defaultGrams = 300.0\n            extractedItems.add(\n                FoodItemDetail(\n                    name = text.take(15).ifBlank { \"\350\220\245\345\205\273\345\207\217\350\204\202\351\244\220\" },\n                    estimatedGrams = defaultGrams,\n                    calories = defaultCal,\n                    proteinG = defaultP,\n                    carbsG = defaultC,\n                    fatG = defaultF\n                )\n            )\n            matchedSummaries.add(text.take(20).ifBlank { \"\344\274\230\350\264\250\345\207\217\350\204\202\351\244\220\351\245\256\" })\n        }\n\n        val totalCal = Math.round(extractedItems.sumOf { it.calories } * 10.0) / 10.0\n        val totalProtein = Math.round(extractedItems.sumOf { it.proteinG } * 10.0) / 10.0\n        val totalCarbs = Math.round(extractedItems.sumOf { it.carbsG } * 10.0) / 10.0\n        val totalFat = Math.round(extractedItems.sumOf { it.fatG } * 10.0) / 10.0\n        val summaryText = matchedSummaries.joinToString(\" + \")\n\n        return ParsedDietResult(\n            mealType = mealType,\n            foodSummary = summaryText,\n            totalCalories = totalCal,\n            proteinG = totalProtein,\n            carbsG = totalCarbs,\n            fatG = totalFat,\n            items = extractedItems,\n            advice = \"AI\350\220\245\345\205\273\347\256\227\346\263\225\357\274\232\346\240\271\346\215\256\351\243\237\347\211\251\345\210\206\351\207\217\347\262\276\347\241\256\350\256\241\347\256\227\347\203\255\351\207\217(${totalCal.toInt()} kcal)\357\274\214\350\233\213\347\231\275\350\264\250\345\205\205\350\266\263\357\274\214\345\212\251\345\212\233\347\274\272\345\217\243\346\216\247\345\210\266\357\274\201\"\n        )\n    }"
