        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var name by remember { mutableStateOf(\"\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var muscle by remember { mutableStateOf(\"\350\203\270\351\203\250\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var sets by remember { mutableStateOf(\"4\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
