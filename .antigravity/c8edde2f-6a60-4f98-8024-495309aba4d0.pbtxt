      target_content: "    // High-precision offline rule-based heuristic fallback for diet voice input\n    private fun fallbackParseDiet(text: String): ParsedDietResult {\n        var cal = 450.0\n        var protein = 25.0\n        var carbs = 50.0\n        var fat = 12.0\n\n        val mealType = when {\n            text.contains(\"\346\227\251\") -> \"\346\227\251\351\244\220\"\n            text.contains(\"\345\215\210\") -> \"\345\215\210\351\244\220\"\n            text.contains(\"\346\231\232\") -> \"\346\231\232\351\244\220\"\n            text.contains(\"\345\212\240\351\244\220\") || text.contains(\"\350\241\245\345\211\202\") || text.contains(\"\350\233\213\347\231\275\347\262\211\") -> \"\345\212\240\351\244\220/\350\241\245\345\211\202\"\n            else -> \"\345\215\210\351\244\220\"\n        }\n\n        // Adjust based on food mentions\n        if (text.contains(\"\351\270\241\350\203\270\350\202\211\")) {\n            protein += 35.0\n            cal += 200.0\n        }\n        if (text.contains(\"\351\270\241\350\233\213\") || text.contains(\"\350\233\213\")) {\n            protein += 14.0\n            fat += 10.0\n            cal += 150.0\n        }\n        if (text.contains(\"\347\261\263\351\245\255\") || text.contains(\"\351\245\255\")) {\n            carbs += 45.0\n            cal += 220.0\n        }\n        if (text.contains(\"\347\211\233\350\202\211\")) {\n            protein += 32.0\n            fat += 12.0\n            cal += 240.0\n        }\n        if (text.contains(\"\347\211\233\345\245\266\") || text.contains(\"\345\245\266\")) {\n            protein += 8.0\n            carbs += 12.0\n            fat += 8.0\n            cal += 150.0\n        }\n        if (text.contains(\"\350\233\213\347\231\275\347\262\211\")) {\n            protein += 25.0\n            carbs += 3.0\n            cal += 120.0\n        }\n        if (text.contains(\"\346\262\231\346\213\211\") || text.contains(\"\350\245\277\350\223\235\350\212\261\") || text.contains(\"\350\224\254\350\217\234\")) {\n            carbs += 8.0\n            cal += 40.0\n        }\n\n        return ParsedDietResult(\n            mealType = mealType,\n            foodSummary = text.ifBlank { \"\345\270\270\350\247\204\350\220\245\345\205\273\351\244\220\" },\n            totalCalories = cal,\n            proteinG = protein,\n            carbsG = carbs,\n            fatG = fat,\n            items = listOf(\n                FoodItemDetail(name = text.take(15), estimatedGrams = 250.0, calories = cal, proteinG = protein, carbsG = carbs, fatG = fat)\n            ),\n            advice = \"\345\220\210\347\220\206\350\241\245\345\205\205\350\233\213\347\231\275\350\264\250\344\270\216\347\242\263\346\260\264\357\274\214\345\212\251\345\212\233\350\202\214\350\202\211\344\277\256\345\244\215\344\270\216\347\203\255\351\207\217\347\274\272\345\217\243\346\216\247\345\210\266\343\200\202\"\n        )\n    }"
      replacement_content: "    // High-precision offline rule-based heuristic fallback for diet voice input\n    private fun fallbackParseDiet(text: String): ParsedDietResult {\n        val mealType = when {\n            text.contains(\"\346\227\251\") -> \"\346\227\251\351\244\220\"\n            text.contains(\"\345\215\210\") -> \"\345\215\210\351\244\220\"\n            text.contains(\"\346\231\232\") -> \"\346\231\232\351\244\220\"\n            text.contains(\"\345\212\240\351\244\220\") || text.contains(\"\350\241\245\345\211\202\") || text.contains(\"\350\233\213\347\231\275\347\262\211\") || text.contains(\"\347\273\203\345\220\216\") -> \"\345\212\240\351\244\220/\350\241\245\345\211\202\"\n            else -> \"\345\215\210\351\244\220\"\n        }\n\n        // Database of nutritional density per 100g: Pair(name, caloriesPer100g, proteinPer100g, carbsPer100g, fatPer100g, defaultGrams)\n        data class FoodProfile(\n            val keywords: List<String>,\n            val displayName: String,\n            val kcalPer100g: Double,\n            val pPer100g: Double,\n            val cPer100g: Double,\n            val fPer100g: Double,\n            val defaultGrams: Double\n        )\n\n        val foodDatabase = listOf(\n            FoodProfile(listOf(\"\351\270\241\350\203\270\350\202\211\", \"\351\270\241\350\202\211\", \"\351\270\241\346\216\222\"), \"\351\246\231\347\205\216\351\270\241\350\203\270\350\202\211\", 133.0, 23.0, 0.0, 3.6, 200.0),\n            FoodProfile(listOf(\"\347\211\233\350\202\211\", \"\347\211\233\346\216\222\", \"\347\211\233\350\205\251\", \"\351\205\261\347\211\233\350\202\211\"), \"\347\262\276\347\230\246\347\211\233\350\202\211\", 180.0, 22.0, 0.0, 10.0, 200.0),\n            FoodProfile(listOf(\"\347\261\263\351\245\255\", \"\347\231\275\347\261\263\351\245\255\", \"\347\264\253\347\261\263\351\245\255\", \"\347\263\231\347\261\263\351\245\255\", \"\347\261\263\"), \"\347\261\263\351\245\255\", 116.0, 2.6, 25.5, 0.3, 200.0),\n            FoodProfile(listOf(\"\346\260\264\347\205\256\350\233\213\", \"\347\205\216\350\233\213\", \"\351\270\241\350\233\213\", \"\350\233\213\"), \"\351\270\241\350\233\213\", 143.0, 12.6, 0.8, 9.5, 100.0),\n            FoodProfile(listOf(\"\350\233\213\347\231\275\347\262\211\", \"\344\271\263\346\270\205\350\233\213\347\231\275\", \"\347\262\211\"), \"\344\271\263\346\270\205\350\233\213\347\231\275\347\262\211\", 380.0, 80.0, 8.0, 5.0, 30.0),\n            FoodProfile(listOf(\"\347\211\233\345\245\266\", \"\350\204\261\350\204\202\345\245\266\", \"\351\262\234\345\245\266\", \"\345\245\266\"), \"\347\272\257\347\211\233\345\245\266\", 60.0, 3.2, 4.8, 3.2, 250.0),\n            FoodProfile(listOf(\"\350\245\277\345\205\260\350\212\261\", \"\350\245\277\350\223\235\350\212\261\"), \"\346\260\264\347\205\256\350\245\277\345\205\260\350\212\261\", 34.0, 2.8, 6.6, 0.4, 150.0),\n            FoodProfile(listOf(\"\350\224\254\350\217\234\", \"\351\235\222\350\217\234\", \"\347\224\237\350\217\234\", \"\351\273\204\347\223\234\", \"\346\262\231\346\213\211\"), \"\346\227\266\344\273\244\350\224\254\350\217\234\", 25.0, 1.5, 4.5, 0.2, 150.0),\n            FoodProfile(listOf(\"\351\246\231\350\225\211\"), \"\346\226\260\351\262\234\351\246\231\350\225\211\", 89.0, 1.1, 22.8, 0.3, 120.0),\n            FoodProfile(listOf(\"\350\213\271\346\236\234\"), \"\347\272\242\345\257\214\345\243\253\350\213\271\346\236\234\", 52.0, 0.3, 13.8, 0.2, 150.0),\n            FoodProfile(listOf(\"\347\207\225\351\272\246\", \"\347\207\225\351\272\246\347\211\207\"), \"\345\205\250\350\260\267\347\211\251\347\207\225\351\272\246\347\211\207\", 370.0, 14.0, 62.0, 7.0, 80.0),\n            FoodProfile(listOf(\"\345\205\250\351\272\246\351\235\242\345\214\205\", \"\351\235\242\345\214\205\", \"\345\220\220\345\217\270\"), \"\345\205\250\351\272\246\351\235\242\345\214\205\", 260.0, 10.0, 48.0, 3.0, 70.0),\n            FoodProfile(listOf(\"\344\270\211\346\226\207\351\261\274\", \"\351\261\274\350\202\211\", \"\351\261\274\346\216\222\", \"\351\263\225\351\261\274\"), \"\344\270\211\346\226\207\351\261\274\346\216\222\", 160.0, 20.0, 0.0, 9.0, 180.0),\n            FoodProfile(listOf(\"\350\231\276\", \"\350\231\276\344\273\201\", \"\345\237\272\345\233\264\350\231\276\"), \"\346\270\205\350\222\270\351\262\234\350\231\276\344\273\201\", 99.0, 20.0, 0.2, 1.3, 150.0),\n            FoodProfile(listOf(\"\350\261\206\350\205\220\", \"\345\215\203\345\274\240\", \"\350\261\206\345\271\262\"), \"\346\260\264\350\261\206\350\205\220\", 84.0, 8.1, 3.8, 4.2, 150.0),\n            FoodProfile(listOf(\"\345\235\232\346\236\234\", \"\345\267\264\346\227\246\346\234\250\", \"\346\240\270\346\241\203\", \"\350\212\261\347\224\237\"), \"\346\267\267\345\220\210\345\235\232\346\236\234\", 600.0, 20.0, 20.0, 50.0, 30.0),\n            FoodProfile(listOf(\"\347\272\242\350\226\257\", \"\347\264\253\350\226\257\", \"\345\234\260\347\223\234\", \"\347\216\211\347\261\263\"), \"\350\222\270\347\272\242\350\226\257/\347\216\211\347\261\263\", 86.0, 1.6, 20.1, 0.2, 150.0),\n            FoodProfile(listOf(\"\351\235\242\346\235\241\", \"\346\204\217\351\235\242\", \"\346\213\211\351\235\242\"), \"\347\205\256\346\204\217\351\235\242/\351\235\242\346\235\241\", 140.0, 5.0, 28.0, 1.0, 200.0)\n        )\n\n        val extractedItems = mutableListOf<FoodItemDetail>()\n        val matchedSummaries = mutableListOf<String>()\n\n        for (profile in foodDatabase) {\n            val matchedKeyword = profile.keywords.firstOrNull { text.contains(it) }\n            if (matchedKeyword != null) {\n                // Try to extract gram count near the keyword (e.g. 200\345\205\213, 200g, 2\344\270\252, 1\345\213\272, 250ml)\n                var grams = profile.defaultGrams\n                \n                // Pattern for explicit grams: e.g. \"\351\270\241\350\203\270\350\202\211200\345\205\213\" or \"200g\351\270\241\350\203\270\350\202\211\"\n                val gramPattern = Pattern.compile(\"(?:\" + Pattern.quote(matchedKeyword) + \"\\\\s*(\\\\d+)|(\\\\d+)\\\\s*(?:\345\205\213|g|\345\215\203\345\205\213|kg|ml|\346\257\253\345\215\207)?\\\\s*\" + Pattern.quote(matchedKeyword) + \"|(\\\\d+)\\\\s*(?:\345\205\213|g|ml|\346\257\253\345\215\207))\")\n                val matcher = gramPattern.matcher(text)\n                if (matcher.find()) {\n                    val g1 = matcher.group(1)?.toDoubleOrNull()\n                    val g2 = matcher.group(2)?.toDoubleOrNull()\n                    val g3 = matcher.group(3)?.toDoubleOrNull()\n                    val detected = g1 ?: g2 ?: g3\n                    if (detected != null && detected in 5.0..2000.0) {\n                        grams = detected\n                    }\n                } else if (text.contains(\"\344\270\244\344\270\252\") || text.contains(\"2\344\270\252\") || text.contains(\"2\345\217\252\")) {\n                    if (profile.displayName.contains(\"\351\270\241\350\233\213\")) grams = 100.0\n                } else if (text.contains(\"\344\270\211\344\270\252\") || text.contains(\"3\344\270\252\")) {\n                    if (profile.displayName.contains(\"\351\270\241\350\233\213\")) grams = 150.0\n                } else if (text.contains(\"\344\270\200\345\213\272\") || text.contains(\"1\345\213\272\")) {\n                    if (profile.displayName.contains(\"\350\233\213\347\231\275\347\262\211\")) grams = 30.0\n                } else if (text.contains(\"\344\270\244\345\213\272\") || text.contains(\"2\345\213\272\")) {\n                    if (profile.displayName.contains(\"\350\233\213\347\231\275\347\262\211\")) grams = 60.0\n                } else if (text.contains(\"\344\270\200\345\260\217\347\242\227\") || text.contains(\"1\347\242\227\")) {\n                    if (profile.displayName.contains(\"\347\261\263\351\245\255\")) grams = 150.0\n                } else if (text.contains(\"\344\270\200\345\244\247\347\242\227\")) {\n                    if (profile.displayName.contains(\"\347\261\263\351\245\255\")) grams = 250.0\n                }\n\n                val itemCalories = Math.round((profile.kcalPer100g * (grams / 100.0)) * 10.0) / 10.0\n                val itemProtein = Math.round((profile.pPer100g * (grams / 100.0)) * 10.0) / 10.0\n                val itemCarbs = Math.round((profile.cPer100g * (grams / 100.0)) * 10.0) / 10.0\n                val itemFat = Math.round((profile.fPer100g * (grams / 100.0)) * 10.0) / 10.0\n\n                extractedItems.add(\n                    FoodItemDetail(\n                        name = profile.displayName,\n                        estimatedGrams = grams,\n                        calories = itemCalories,\n                        proteinG = itemProtein,\n                        carbsG = itemCarbs,\n                        fatG = itemFat\n                    )\n                )\n                matchedSummaries.add(\"${profile.displayName}${grams.toInt()}g\")\n            }\n        }\n\n        // Fallback if no specific food recognized\n        if (extractedItems.isEmpty()) {\n            val defaultCal = 480.0\n            val defaultP = 30.0\n            val defaultC = 55.0\n            val defaultF = 12.0\n            val defaultGrams = 300.0\n            extractedItems.add(\n                FoodItemDetail(\n                    name = text.take(15).ifBlank { \"\350\220\245\345\205\273\345\207\217\350\204\202\351\244\220\" },\n                    estimatedGrams = defaultGrams,\n                    calories = defaultCal,\n                    proteinG = defaultP,\n                    carbsG = defaultC,\n                    fatG = defaultF\n                )\n            )\n            matchedSummaries.add(text.take(20).ifBlank { \"\344\274\230\350\264\250\345\207\217\350\204\202\351\244\220\351\245\256\" })\n        }\n\n        val totalCal = Math.round(extractedItems.sumOf { it.calories } * 10.0) / 10.0\n        val totalProtein = Math.round(extractedItems.sumOf { it.proteinG } * 10.0) / 10.0\n        val totalCarbs = Math.round(extractedItems.sumOf { it.carbsG } * 10.0) / 10.0\n        val totalFat = Math.round(extractedItems.sumOf { it.fatG } * 10.0) / 10.0\n        val summaryText = matchedSummaries.joinToString(\" + \")\n\n        return ParsedDietResult(\n            mealType = mealType,\n            foodSummary = summaryText,\n            totalCalories = totalCal,\n            proteinG = totalProtein,\n            carbsG = totalCarbs,\n            fatG = totalFat,\n            items = extractedItems,\n            advice = \"AI\350\220\245\345\205\273\347\256\227\346\263\225\357\274\232\346\240\271\346\215\256\351\243\237\347\211\251\345\210\206\351\207\217\347\262\276\347\241\256\350\256\241\347\256\227\347\203\255\351\207\217(${totalCal.toInt()} kcal)\357\274\214\350\233\213\347\231\275\350\264\250\345\205\205\350\266\263\357\274\214\345\212\251\345\212\233\347\274\272\345\217\243\346\216\247\345\210\266\357\274\201\"\n        )\n    }"
