  file_change {
    absolute_path_uri: "file:///app/src/main/java/com/example/data/model/UserProfile.kt"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "package com.example.data.model\n\nimport androidx.room.Entity\nimport androidx.room.PrimaryKey\n\n@Entity(tableName = \"user_profile\")\ndata class UserProfile(\n    @PrimaryKey val id: Int = 1,\n    val name: String = \"\345\201\245\350\272\253\350\276\276\344\272\272\",\n    val gender: String = \"male\", // male, female\n    val age: Int = 25,\n    val heightCm: Double = 175.0,\n    val weightKg: Double = 72.0,\n    val activityLevel: String = \"moderate\", // sedentary, light, moderate, active, extreme\n    val targetDeficitKcal: Double = 400.0, // \346\257\217\346\227\245\347\233\256\346\240\207\347\203\255\351\207\217\347\274\272\345\217\243\n    val targetProteinG: Double = 140.0, // \347\233\256\346\240\207\350\233\213\347\231\275\350\264\250 (g)\n    val targetCarbsG: Double = 220.0, // \347\233\256\346\240\207\347\242\263\346\260\264 (g)\n    val targetFatG: Double = 55.0, // \347\233\256\346\240\207\350\204\202\350\202\252 (g)\n    val goalType: String = \"fat_loss\" // fat_loss (\345\207\217\350\204\202), muscle_gain (\345\242\236\350\202\214), maintenance (\347\273\264\346\214\201)\n) {\n    // Mifflin-St Jeor Formula for BMR\n    val bmr: Double\n        get() {\n            return if (gender.lowercase() == \"female\") {\n                (10 * weightKg) + (6.25 * heightCm) - (5 * age) - 161\n            } else {\n                (10 * weightKg) + (6.25 * heightCm) - (5 * age) + 5\n            }\n        }\n\n    // TDEE (Total Daily Energy Expenditure) without specific workout\n    val tdee: Double\n        get() {\n            val multiplier = when (activityLevel) {\n                \"sedentary\" -> 1.2\n                \"light\" -> 1.375\n                \"moderate\" -> 1.55\n                \"active\" -> 1.725\n                \"extreme\" -> 1.9\n                else -> 1.55\n            }\n            return bmr * multiplier\n        }\n}\n"
    }
