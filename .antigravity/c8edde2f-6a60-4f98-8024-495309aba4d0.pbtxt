        }
        lines {
          text: "    val currentDeficit = summary.calorieDeficit"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Deficit completion ratio (0.0 to 1.5)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val progressRatio = if (targetDeficit > 0) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        (currentDeficit / targetDeficit).coerceIn(0.0, 1.5).toFloat()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    } else 0f"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val animatedProgress by animateFloatAsState("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        targetValue = (progressRatio / 1.0f).coerceIn(0f, 1f),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        animationSpec = tween(durationMillis = 900),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        label = \"gaugeProgress\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val isDeficitPositive = currentDeficit >= 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val isTargetAchieved = currentDeficit >= targetDeficit"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val statusBadgeColor = when {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        isTargetAchieved -> ElectricLime"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        isDeficitPositive -> NeonCyan"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        else -> FireRed"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
