    instruction: "Add DailyDeficitTrackerWidget into DietScreen and enhance meal card display"
    replacement_infos {
      original_chunk {
        target_content: "@Composable\nfun DietScreen(\n    viewModel: FitnessViewModel,\n    onOpenDictation: (DictationMode) -> Unit\n) {\n    val selectedDate by viewModel.selectedDate.collectAsState()\n    val dietLogs by viewModel.dietLogsForSelectedDate.collectAsState()\n    val profile by viewModel.userProfile.collectAsState()\n\n    var showManualAddDialog by remember { mutableStateOf(false) }\n\n    val totalCalories = dietLogs.sumOf { it.calories }\n    val totalProtein = dietLogs.sumOf { it.proteinG }\n    val totalCarbs = dietLogs.sumOf { it.carbsG }\n    val totalFat = dietLogs.sumOf { it.fatG }\n\n    if (showManualAddDialog) {\n        ManualDietDialog(\n            currentDate = selectedDate,\n            onConfirm = {\n                viewModel.addManualDiet(it)\n                showManualAddDialog = false\n            },\n            onDismiss = { showManualAddDialog = false }\n        )\n    }\n\n    LazyColumn(\n        modifier = Modifier\n            .fillMaxSize()\n            .padding(horizontal = 16.dp),\n        contentPadding = PaddingValues(top = 16.dp, bottom = 100.dp),\n        verticalArrangement = Arrangement.spacedBy(16.dp)\n    ) {\n        // Header\n        item {\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Column {\n                    Text(\n                        text = \"\351\245\256\351\243\237\344\270\216\347\203\255\351\207\217\350\256\260\345\275\225\",\n                        color = TextPrimary,\n                        fontSize = 22.sp,\n                        fontWeight = FontWeight.Black\n                    )\n                    Text(\n                        text = \"$selectedDate \351\245\256\351\243\237\346\230\216\347\273\206\344\270\216\350\220\245\345\205\273\",\n                        color = TextSecondary,\n         